#!/usr/bin/env bash
# User-local wrapper around omarchy-agent-usage-update.
# Runs collectors from ~/.config/omarchy/agents first so they override the
# packaged ones (Codex 0.149 broke `-a untrusted` in the stock collector).
set -euo pipefail

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/agents"
PACKAGED="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent-usage-update"
PROFILE_COLLECTOR="$USER_DIR/account-profile-collector.py"

mkdir -p "$USAGE_DIR"

except=()
status=0
user_flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
    --force|--limits-only) user_flags+=("$1") ;;
    --except)
      [[ $# -ge 2 ]] || { echo "run-usage-update: --except needs an id" >&2; exit 2; }
      excluded["$2"]=1
      shift
      ;;
    --*) echo "run-usage-update: unknown option: $1" >&2; exit 2 ;;
    *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1" candidate
  [[ -n ${excluded[$agent]:-} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

account_wanted() {
  local agent="$1" provider="$2" candidate
  [[ -n ${excluded[$agent]:-} || -n ${excluded[$provider]:-} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" || $candidate == "$provider" ]] && return 0
  done
  return 1
}

collect_stdout() {
  local collector="$1" agent="$2"
  shift 2
  local record tmp
  if ! record=$(python3 "$collector" "$@") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "run-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

declare -A configured successful_providers
if [[ -f $PROFILE_COLLECTOR ]]; then
  if account_json=$(python3 "$PROFILE_COLLECTOR" --list); then
    while IFS=$'\t' read -r agent provider; do
      [[ -n $agent && -n $provider ]] || continue
      configured["$agent"]=1
      except+=(--except "$agent")
      account_wanted "$agent" "$provider" || continue
      if collect_stdout "$PROFILE_COLLECTOR" "$agent" --account "$agent" "${user_flags[@]}"; then
        successful_providers["$provider"]=1
      else
        status=1
      fi
    done < <(jq -r '.[] | [.id, .provider] | @tsv' <<<"$account_json")
  else
    echo "run-usage-update: account profile configuration failed" >&2
    status=1
  fi
fi

for provider in "${!successful_providers[@]}"; do
  excluded["$provider"]=1
  # Usage files are generated snapshots. Once a profile record succeeds, the
  # packaged aggregate would duplicate it and can carry another account's
  # cached limits. Keep an explicitly configured provider-id account itself.
  [[ -n ${configured[$provider]:-} ]] || rm -f -- "$USAGE_DIR/$provider.json"
done

shopt -s nullglob
for collector in "$USER_DIR"/omarchy-agent-usage-*; do
  [[ -x $collector || -f $collector ]] || continue
  agent="${collector##*/omarchy-agent-usage-}"
  [[ $agent == "update" ]] && continue
  [[ -n ${configured[$agent]:-} ]] && continue
  except+=(--except "$agent")
  wanted "$agent" || continue
  collect_stdout "$collector" "$agent" "${user_flags[@]}" || status=1
done

if [[ -x $PACKAGED ]]; then
  packaged_args=("${user_flags[@]}" "${except[@]}")
  for agent in "${!excluded[@]}"; do packaged_args+=(--except "$agent"); done
  packaged_args+=("${only[@]}")
  "$PACKAGED" "${packaged_args[@]}" || status=1
fi

exit "$status"
